{
    "name": "quillstack/queue",
    "description": "A simple queue: messages, handlers and workers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "queue",
        "jobs",
        "worker",
        "messages",
        "php8"
    ],
    "homepage": "https://quillstack.org/packages/queue",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "quillstack/clock": "^0.6",
        "quillstack/storage-interface": "^0.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/db": "^0.6",
        "quillstack/di": "^0.6",
        "quillstack/local-storage": "^0.6",
        "quillstack/unit-tests": "^0.9"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\Queue\\": "src/",
            "Quillstack\\Queue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr ./vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    },
    "suggest": {
        "ext-redis": "To keep the messages in Redis, for a queue busy enough that they are worth keeping out of the database (RedisQueue).",
        "quillstack/db": "To keep the messages in a database, so a worker on another machine can pick them up (DatabaseQueue)."
    }
}
